# Exemplo mínimo do runtime C4G. Use valores locais próprios e nunca registe segredos reais.
NODE_ENV=development
PORT=5000
PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

AUTH_MODE=oidc
OIDC_ISSUER=https://localhost:8443/realms/c4g-native-local
OIDC_CLIENT_ID=c4g-native-local
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/login
# Generate privately: node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('hex'))"
# Rotating this value invalidates existing sessions and encrypted account tokens.
SESSION_SECRET=GENERATE_WITH_NODE_CRYPTO_RANDOMBYTES_32_HEX
SESSION_COOKIE_NAME=c4g_native_local
SESSION_IDLE_MS=1800000
SESSION_ABSOLUTE_MS=28800000
OIDC_TRANSACTION_MS=600000
AUTH_POLICY_VERSION=c4g-assurance-v1
AUTH_ASSURANCE_POLICY_JSON={"recent-mfa":{"mfa":true,"maxAgeSeconds":300,"acceptedAcr":["c4g-loa2"],"acceptedAmr":["otp"],"amrMode":"all"}}
# Generate an independent 32-byte hexadecimal key as above; coordinate rotation across API and workers.
AUTHORITY_COMMIT_PERMIT_SECRET=GENERATE_A_SEPARATE_RANDOM_32_BYTE_HEX_KEY

# Number of reverse proxies in front of the API (default 1). Must match the real topology.
# TRUST_PROXY_HOPS=1
# Optional per-address request budgets per minute (defaults: 60 for OIDC login/callback, 3000 for /api).
# Counters are per API process; keep matching limits at the proxy.
# RATE_LIMIT_AUTH_PER_MINUTE=60
# RATE_LIMIT_API_PER_MINUTE=3000

# In production, non-loopback PostgreSQL URLs must carry sslmode=verify-full (require/verify-ca also accepted).
CENTRAL_DATABASE_URL=postgresql://C4G_CENTRAL_USER:C4G_CENTRAL_PASSWORD@127.0.0.1:5432/C4G_CENTRAL_DATABASE
CATALOG_DATABASE_URL=postgresql://C4G_CATALOG_USER:C4G_CATALOG_PASSWORD@127.0.0.1:5432/C4G_CENTRAL_DATABASE
OPPORTUNITY_API_CREDENTIALS_JSON=[]
# Optional dedicated Central login for F12 receipt recovery. Requires the registered receipt schemas.
F12_RECEIPT_RECOVERY_DATABASE_URL=
OPPORTUNITY_ALLOWED_RESIDENCY_JSON=[{"regionCode":"LOCAL","policyVersion":"local-development-v1"}]

FUNDING_TENDERS_RUNTIME=disabled
# Requires central migration 033 and validated runtime composition. No automatic migration.
FUNDING_TENDERS_COVERAGE=disabled
# Explicit registered Central042/tenant034 package; never installed at startup.
OPPORTUNITY_ACTIVATION_RUNTIME=disabled
# bounded-v2 requires authenticated-v2 above; restricts collection/acceptance to CASCADE:11145.
OPPORTUNITY_11145_EXECUTOR=disabled
# canonical-v2 requires registered Central043, authenticated-v2, central funding,
# durable-v1 coverage and FUNDING_TENDERS_ENRICHMENT=verified-v1. It never resumes EU at startup.
OPPORTUNITY_EU_WRITER=disabled
OPPORTUNITY_IMPORTS_RUNTIME=disabled
# F12 receipt worker. Set the organization UUID to activate the built-in adapter.
# Use a separate process, provision its pg-boss queues and F4 tenant role profile first.
F12_OPPORTUNITY_WORKER_ORGANIZATION_ID=
F12_OPPORTUNITY_WORKER_CREDENTIALS_JSON=
F12_OPPORTUNITY_QUEUE_DATABASE_URL=
F12_RECEIPT_ISSUER_DATABASE_URL=
# Optional absolute path for an alternative infrastructure module.
F12_OPPORTUNITY_WORKER_PROVIDER=
# Central XLSX upload/preview only. Requires registered central upload/preview schema,
# validated private R2 EU storage and loopback ClamAV. Does not enable publication.
CENTRAL_PT2030_IMPORT_RUNTIME=disabled
DOCUMENTS_RUNTIME=disabled
PROFILE_EDITORIAL_RUNTIME=disabled
# Member activation email (loaded into the identity worker environment).
# Configure a verified sender and the public HTTPS application origin before enabling.
RESEND_API_KEY=
ACTIVATION_EMAIL_FROM=
ACTIVATION_PUBLIC_URL=


# Optional private fiscal PDFs; explicit central package 050 and document storage/scanner required.
BILLING_PDF_RUNTIME=disabled
