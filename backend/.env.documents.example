# Server-only template. Private target from repository root:
# .tmp/local-platform/documents.env (already ignored by Git).
# The native application is NOT activated by filling this template.
# Its APPLICATION/F11/F9 composition and real service gates must be completed.
C4G_R2_ENDPOINT=
C4G_R2_DOCUMENTS_BUCKET=
C4G_R2_QUARANTINE_BUCKET=
C4G_R2_ACCESS_KEY_ID=
C4G_R2_SECRET_ACCESS_KEY=
# ClamD TCP has no TLS/authentication: this adapter accepts loopback only.
C4G_CLAMAV_HOST=127.0.0.1
C4G_CLAMAV_PORT=3310
