# Copy to /srv/c4g-production/releases/<release-id>/release.env, not to the repository .env.
# Empty values deliberately stop compose interpolation. Resolve images to @sha256:64hex after building/verifying.
C4G_PRODUCTION_IMAGE=
C4G_PRODUCTION_POD_IMAGE=
C4G_PRODUCTION_CLAMAV_IMAGE=
C4G_PRODUCTION_CONFIG=
