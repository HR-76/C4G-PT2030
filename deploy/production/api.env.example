# NOT RUNNABLE: replace every REPLACE_* from production-only provisioned state, never from a test environment.
NODE_ENV=production
PORT=5000
AUTH_MODE=oidc
PUBLIC_APP_URL=https://gcni.c4g.ai
CORS_ORIGIN=https://gcni.c4g.ai
# Realm/client names and timeouts below are proposals; create and verify them in the new Keycloak.
OIDC_ISSUER=https://login.c4g.ai/realms/c4g-production
OIDC_CLIENT_ID=c4g-production-web
OIDC_CLIENT_SECRET=REPLACE_OIDC_CLIENT_SECRET
OIDC_REDIRECT_URI=https://gcni.c4g.ai/api/auth/oidc/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://gcni.c4g.ai/login
SESSION_COOKIE_NAME=__Host-c4g_production_session
SESSION_SECRET=REPLACE_64_HEX_OR_LONGER
AUTHORITY_COMMIT_PERMIT_SECRET=REPLACE_OTHER_64_HEX_OR_LONGER
SESSION_IDLE_MS=1800000
SESSION_ABSOLUTE_MS=28800000
OIDC_TRANSACTION_MS=600000
AUTH_POLICY_VERSION=c4g-user-mfa-v1
PRIVILEGED_LOGIN_ASSURANCE_CATEGORY=recent-auth
AUTH_ASSURANCE_POLICY_JSON={"recent-auth":{"mfa":false,"maxAgeSeconds":300,"acceptedAcr":["c4g-loa1"],"acceptedAmr":["pwd"],"amrMode":"any"}}
# Must match the real trusted proxy chain; do not enable while this remains a placeholder.
TRUST_PROXY_HOPS=REPLACE_VERIFIED_HOP_COUNT
CENTRAL_RUNTIME_PROFILE=production-v1
CENTRAL_DATABASE_URL=postgresql://c4g_prod_api_read:REPLACE_READ@c4g-production-postgres:5432/c4g_central_production?sslmode=verify-full
CENTRAL_COMMANDS_DATABASE_URL=postgresql://c4g_prod_api_commands:REPLACE_COMMANDS@c4g-production-postgres:5432/c4g_central_production?sslmode=verify-full
CENTRAL_AUTHORING_DATABASE_URL=postgresql://c4g_prod_catalog_authoring:REPLACE_AUTHORING@c4g-production-postgres:5432/c4g_central_production?sslmode=verify-full
CENTRAL_LOGS_DATABASE_URL=postgresql://c4g_prod_logs:REPLACE_LOGS@c4g-production-postgres:5432/c4g_central_production?sslmode=verify-full
AUTHORITY_DATABASE_URL=postgresql://c4g_authority_runtime:REPLACE_AUTHORITY@c4g-production-postgres:5432/c4g_central_production?sslmode=verify-full
CATALOG_DATABASE_URL=postgresql://c4g_prod_catalog_read:REPLACE_CATALOG@c4g-production-postgres:5432/c4g_central_production?sslmode=verify-full
AUTHORITY_DB_POOL_MAX=8
CENTRAL_API_ORGANIZATIONS_JSON=["REPLACE_ORGANIZATION_UUID"]
OPPORTUNITY_API_CREDENTIALS_JSON=[{"tenantId":"REPLACE_TENANT_UUID","credentialRef":"REPLACE_PUBLISHED_REF","connectionVersion":1,"host":"c4g-production-postgres","port":5432,"database":"REPLACE_PROVISIONED_TENANT_DATABASE","login":"REPLACE_LIMITED_TENANT_API_LOGIN","password":"REPLACE_TENANT_PASSWORD","ssl":true}]
OPPORTUNITY_ALLOWED_RESIDENCY_JSON=[{"regionCode":"EU","policyVersion":"REPLACE_PUBLISHED_RESIDENCY_POLICY"}]
PLATFORM_LOGS_RUNTIME=central
# Access changes require recent authentication under the configured policy; MFA remains optional.
PLATFORM_ACCESS_RUNTIME=central
FUNDING_TENDERS_RUNTIME=central
FUNDING_TENDERS_SOURCE=unconfigured
CENTRAL_PT2030_IMPORT_RUNTIME=catalog
BILLING_PDF_RUNTIME=private
DOCUMENTS_RUNTIME=disabled
OPPORTUNITY_IMPORTS_RUNTIME=disabled
OPPORTUNITY_ACTIVATION_RUNTIME=disabled
OPPORTUNITY_COMPLEMENT_COLLECTION=disabled
# Normal catalog reader remains enabled above. The separate controlled runtime is not ready for 057.
CATALOG_READ_RUNTIME=disabled
# Product flags below need tenant roles/schema from the production provisioner.
PROFILE_EDITORIAL_RUNTIME=f13-editorial
PQ1_ACTIVATION_RUNTIME=f13-f14-pq1
PROFILE_EDITORIAL_UI_KEY_ID=production-1
PROFILE_EDITORIAL_UI_KEYS_JSON={"production-1":"REPLACE_INDEPENDENT_64_HEX_OR_LONGER"}
# Enable these only after registered058, private worker/Keycloak configuration and isolated acceptance.
# This is NOT approval to remove those features from the production product.
MEMBER_ONBOARDING_RUNTIME=disabled
USER_DELETION_RUNTIME=disabled
# Confirm required email/billing scope and dedicated workers before activating any of these.
BILLING_VALIDATION_RUNTIME=disabled
EMAIL_AUTHENTICATION_RUNTIME=disabled
EMAIL_HISTORY_RUNTIME=disabled
C4G_R2_ENDPOINT=https://REPLACE_ACCOUNT.eu.r2.cloudflarestorage.com
C4G_R2_DOCUMENTS_BUCKET=REPLACE_PRODUCTION_PRIVATE_DOCUMENTS_BUCKET
C4G_R2_QUARANTINE_BUCKET=REPLACE_PRODUCTION_PRIVATE_QUARANTINE_BUCKET
C4G_R2_ACCESS_KEY_ID=REPLACE_PRODUCTION_R2_ACCESS_KEY
C4G_R2_SECRET_ACCESS_KEY=REPLACE_PRODUCTION_R2_SECRET
# Never mark validated before the actual production bucket capability proof.
C4G_R2_LAYER_C_VALIDATED=false
C4G_R2_MULTIPART_CONDITIONAL_VALIDATED=false
C4G_CLAMAV_HOST=127.0.0.1
C4G_CLAMAV_PORT=3310
